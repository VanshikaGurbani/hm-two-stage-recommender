# Copy this file to `.env` (git-ignored) and fill in ONE of the two options.
# Never commit `.env` and never paste these values in chat or issues.

# Option A - new-style Kaggle API token (one long string, kaggle.com > Settings > API)
KAGGLE_API_TOKEN=

# Option B - legacy token (the two fields inside a downloaded kaggle.json)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
